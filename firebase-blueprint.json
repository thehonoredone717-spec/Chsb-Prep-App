{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered student or teacher profile for the Grade 7 ChSB platform",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128
        },
        "username": {
          "type": "string",
          "description": "Normalized lowercase username",
          "minLength": 3,
          "maxLength": 32,
          "pattern": "^[a-z0-9_.]{3,32}$"
        },
        "displayName": {
          "type": "string",
          "description": "Student or teacher display name",
          "minLength": 1,
          "maxLength": 60
        },
        "role": {
          "type": "string",
          "enum": ["student", "teacher", "owner"],
          "description": "Access role in the platform: student, subject teacher, or platform owner"
        },
        "email": {
          "type": "string",
          "description": "User email address",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account creation server timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last profile update server timestamp"
        }
      },
      "required": ["uid", "username", "displayName", "role", "createdAt", "updatedAt"]
    },
    "QuizAttempt": {
      "title": "QuizAttempt",
      "description": "Immutable completed 25-question ChSB quiz attempt record",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "username": {
          "type": "string",
          "minLength": 3,
          "maxLength": 32,
          "pattern": "^[a-z0-9_.]{3,32}$"
        },
        "studentName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "subjectId": {
          "type": "string",
          "enum": ["math", "history", "science", "computing", "english", "uzbek"]
        },
        "difficulty": {
          "type": "string",
          "enum": ["easy", "medium", "hard"]
        },
        "variant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        },
        "mode": {
          "type": "string",
          "enum": ["practice", "exam"]
        },
        "score": {
          "type": "integer"
        },
        "total": {
          "type": "integer"
        },
        "percentage": {
          "type": "integer"
        },
        "grade": {
          "type": "integer"
        },
        "elapsedSeconds": {
          "type": "integer"
        },
        "completedAt": {
          "type": "string",
          "minLength": 10,
          "maxLength": 40
        },
        "cheated": {
          "type": "boolean",
          "description": "True when test ended with 0 warnings left and a forced 0 score"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "username",
        "studentName",
        "subjectId",
        "difficulty",
        "variant",
        "mode",
        "score",
        "total",
        "percentage",
        "grade",
        "elapsedSeconds",
        "completedAt",
        "createdAt"
      ]
    },
    "StudentAssignment": {
      "title": "StudentAssignment",
      "description": "Teacher-assigned specific variant for a student per subject and difficulty with 1-attempt tracking",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "studentUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "subjectId": {
          "type": "string",
          "enum": ["math", "history", "science", "computing", "english", "uzbek"]
        },
        "difficulty": {
          "type": "string",
          "enum": ["easy", "medium", "hard"]
        },
        "variant": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "attemptsAllowed": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "attemptsUsed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "retakeCodePending": {
          "type": "boolean"
        },
        "assignedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "assignedByName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "studentUid", "subjectId", "difficulty", "variant", "assignedByUid", "assignedByName", "updatedAt"]
    },
    "RetakeCode": {
      "title": "RetakeCode",
      "description": "6-digit unlock code sent to teachers to authorize a student's 2nd attempt on an assigned variant",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "assignmentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "studentUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "studentName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "subjectId": {
          "type": "string",
          "enum": ["math", "history", "science", "computing", "english", "uzbek"]
        },
        "difficulty": {
          "type": "string",
          "enum": ["easy", "medium", "hard"]
        },
        "variant": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "code": {
          "type": "string",
          "minLength": 6,
          "maxLength": 6,
          "pattern": "^[0-9]{6}$"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "used"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "assignmentId",
        "studentUid",
        "studentName",
        "subjectId",
        "difficulty",
        "variant",
        "code",
        "status",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles partitioned by Firebase Auth UID"
    },
    "/attempts/{attemptId}": {
      "schema": { "$ref": "#/entities/QuizAttempt" },
      "description": "Completed quiz attempts visible to the student owner and verified teacher/admin"
    },
    "/subjectPermissions/{subjectId}": {
      "schema": { "$ref": "#/entities/SubjectPermission" },
      "description": "Per-subject Allow/Prohibit state controlled by subject teachers (own subject) and admin (all subjects)"
    },
    "/studentAssignments/{assignmentId}": {
      "schema": { "$ref": "#/entities/StudentAssignment" },
      "description": "Teacher assigned variant per student and subject with 1-attempt tracking"
    },
    "/retakeCodes/{codeId}": {
      "schema": { "$ref": "#/entities/RetakeCode" },
      "description": "Teacher-only 6-digit unlock codes for student 2nd attempts"
    }
  }
}
