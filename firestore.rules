rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && 'email' in request.auth.token
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'thehonoredone.717@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isComputingTeacher() {
      return isSignedIn()
        && 'email' in request.auth.token
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'zarifa.xojiyeva2281@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isMathTeacher() {
      return isSignedIn()
        && 'email' in request.auth.token
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'qoqonovtohir@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isScienceTeacher() {
      return isSignedIn()
        && 'email' in request.auth.token
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'mohinurteshayeva19@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isEnglishTeacher() {
      return isSignedIn()
        && 'email' in request.auth.token
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'melbernard24@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isHistoryTeacher() {
      return isSignedIn()
        && 'email' in request.auth.token
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'kuziyevoybek84@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isUzbekTeacher() {
      return isSignedIn()
        && 'email' in request.auth.token
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'qsurayyo1973@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isIbrohimUser() {
      return isSignedIn()
        && 'email' in request.auth.token
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'ibrohimbekxujanazarov@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isAssignedStudent(studentUid) {
      return isSignedIn() && (
        studentUid == request.auth.uid
        || (isIbrohimUser() && studentUid == 'student_ibrohimbek_profile')
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidSubjectId(id) {
      return id is string && id in ['math', 'history', 'science', 'computing', 'english', 'uzbek'];
    }

    function canManageSubjectPermission(subjectId) {
      return isAdmin()
        || (isComputingTeacher() && subjectId == 'computing')
        || (isMathTeacher() && subjectId == 'math')
        || (isScienceTeacher() && subjectId == 'science')
        || (isEnglishTeacher() && subjectId == 'english')
        || (isHistoryTeacher() && subjectId == 'history')
        || (isUzbekTeacher() && subjectId == 'uzbek');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 3. Entity Validation Blueprints (No existing()/diff() allowed here)
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'username', 'displayName', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'username', 'displayName', 'role', 'email', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid == userId
        && data.username is string
        && data.username.size() >= 3
        && data.username.size() <= 32
        && data.username.matches('^[a-z0-9_.]{3,32}$')
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 60
        && data.role is string
        && data.role in ['student', 'teacher', 'owner']
        && (!('email' in data) || (data.email is string && data.email.size() <= 128))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidQuizAttempt(data, attemptId) {
      return data.keys().hasAll([
          'id', 'userId', 'username', 'studentName', 'subjectId', 'difficulty',
          'variant', 'mode', 'score', 'total', 'percentage', 'grade',
          'elapsedSeconds', 'completedAt', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'username', 'studentName', 'subjectId', 'difficulty',
          'variant', 'mode', 'score', 'total', 'percentage', 'grade',
          'elapsedSeconds', 'completedAt', 'cheated', 'createdAt'
        ])
        && data.id is string
        && data.id.size() >= 1
        && data.id.size() <= 128
        && data.id == attemptId
        && data.userId is string
        && data.userId.size() >= 1
        && data.userId.size() <= 128
        && data.userId == request.auth.uid
        && data.username is string
        && data.username.size() >= 3
        && data.username.size() <= 32
        && data.username.matches('^[a-z0-9_.]{3,32}$')
        && data.studentName is string
        && data.studentName.size() >= 1
        && data.studentName.size() <= 60
        && data.subjectId is string
        && data.subjectId in ['math', 'history', 'science', 'computing', 'english', 'uzbek']
        && data.difficulty is string
        && data.difficulty in ['easy', 'medium', 'hard']
        && data.variant is string
        && data.variant.size() >= 1
        && data.variant.size() <= 24
        && data.mode is string
        && data.mode in ['practice', 'exam']
        && data.total is int
        && data.total >= 5
        && data.total <= 25
        && data.score is int
        && data.score >= 0
        && data.score <= data.total
        && data.percentage is int
        && data.percentage >= 0
        && data.percentage <= 100
        && data.grade is int
        && data.grade in [2, 3, 4, 5]
        && data.elapsedSeconds is int
        && data.elapsedSeconds >= 0
        && data.elapsedSeconds <= 86400
        && data.completedAt is string
        && data.completedAt.size() >= 10
        && data.completedAt.size() <= 40
        && (!('cheated' in data) || data.cheated is bool)
        && data.createdAt is timestamp
        && data.createdAt == request.time;
    }

    function isValidSubjectPermission(data, subjectId) {
      return data.keys().hasAll(['subjectId', 'prohibited', 'updatedByUid', 'updatedByName', 'updatedAt'])
        && data.keys().hasOnly(['subjectId', 'prohibited', 'updatedByUid', 'updatedByName', 'updatedAt'])
        && data.subjectId is string
        && isValidSubjectId(data.subjectId)
        && data.subjectId == subjectId
        && data.prohibited is bool
        && data.updatedByUid is string
        && data.updatedByUid.size() >= 1
        && data.updatedByUid.size() <= 128
        && data.updatedByUid == request.auth.uid
        && data.updatedByName is string
        && data.updatedByName.size() >= 1
        && data.updatedByName.size() <= 60
        && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidStudentAssignment(data, assignmentId) {
      return data.keys().hasAll([
          'id', 'studentUid', 'subjectId', 'difficulty', 'variant',
          'assignedByUid', 'assignedByName', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'studentUid', 'subjectId', 'difficulty', 'variant',
          'attemptsAllowed', 'attemptsUsed', 'retakeCodePending',
          'assignedByUid', 'assignedByName', 'updatedAt'
        ])
        && data.id is string
        && data.id.size() >= 1
        && data.id.size() <= 128
        && data.id == assignmentId
        && data.studentUid is string
        && data.studentUid.size() >= 1
        && data.studentUid.size() <= 128
        && data.subjectId is string
        && isValidSubjectId(data.subjectId)
        && data.difficulty is string
        && data.difficulty in ['easy', 'medium', 'hard']
        && data.variant is int
        && data.variant >= 1
        && data.variant <= 20
        && (!('attemptsAllowed' in data) || (data.attemptsAllowed is int && data.attemptsAllowed >= 1 && data.attemptsAllowed <= 10))
        && (!('attemptsUsed' in data) || (data.attemptsUsed is int && data.attemptsUsed >= 0 && data.attemptsUsed <= 10))
        && (!('retakeCodePending' in data) || data.retakeCodePending is bool)
        && data.assignedByUid is string
        && data.assignedByUid.size() >= 1
        && data.assignedByUid.size() <= 128
        && data.assignedByName is string
        && data.assignedByName.size() >= 1
        && data.assignedByName.size() <= 60
        && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidRetakeCode(data, codeId) {
      return data.keys().hasAll([
          'id', 'assignmentId', 'studentUid', 'studentName',
          'subjectId', 'difficulty', 'variant', 'code', 'status',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'assignmentId', 'studentUid', 'studentName',
          'subjectId', 'difficulty', 'variant', 'code', 'status',
          'createdAt', 'updatedAt'
        ])
        && data.id is string
        && data.id.size() >= 1
        && data.id.size() <= 128
        && data.id == codeId
        && data.assignmentId is string
        && data.assignmentId.size() >= 1
        && data.assignmentId.size() <= 128
        && data.assignmentId == codeId
        && data.studentUid is string
        && data.studentUid.size() >= 1
        && data.studentUid.size() <= 128
        && data.studentName is string
        && data.studentName.size() >= 1
        && data.studentName.size() <= 60
        && data.subjectId is string
        && isValidSubjectId(data.subjectId)
        && data.difficulty is string
        && data.difficulty in ['easy', 'medium', 'hard']
        && data.variant is int
        && data.variant >= 1
        && data.variant <= 20
        && data.code is string
        && data.code.size() == 6
        && data.code.matches('^[0-9]{6}$')
        && data.status is string
        && data.status in ['pending', 'used']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserCosmetics(data, userId) {
      return data.keys().hasAll([
          'uid', 'ownedTitles', 'ownedFrames', 'equippedTitle', 'equippedFrame',
          'spentXp', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'ownedTitles', 'ownedFrames', 'equippedTitle', 'equippedFrame',
          'spentXp', 'createdAt', 'updatedAt'
        ])
        && data.uid is string
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid == userId
        && data.ownedTitles is list
        && data.ownedTitles.size() <= 20
        && (data.ownedTitles.size() == 0 || (data.ownedTitles[0] is string && data.ownedTitles[0].size() <= 40))
        && data.ownedTitles.hasOnly([
          'title_scholar', 'title_blitz_runner', 'title_polymath', 'title_strategist',
          'title_olympian', 'title_prodigy', 'title_grand_sage', 'title_mythic_legend'
        ])
        && data.ownedFrames is list
        && data.ownedFrames.size() <= 20
        && (data.ownedFrames.size() == 0 || (data.ownedFrames[0] is string && data.ownedFrames[0].size() <= 40))
        && data.ownedFrames.hasOnly([
          'frame_mint', 'frame_cobalt', 'frame_amethyst', 'frame_cyber_hex',
          'frame_ruby_flame', 'frame_solar_gold', 'frame_astral_aurora', 'frame_mythic_phoenix'
        ])
        && data.equippedTitle is string
        && data.equippedTitle.size() <= 40
        && (data.equippedTitle == '' || data.equippedTitle in data.ownedTitles)
        && data.equippedFrame is string
        && data.equippedFrame.size() <= 40
        && (data.equippedFrame == '' || data.equippedFrame in data.ownedFrames)
        && data.spentXp is int
        && data.spentXp >= 0
        && data.spentXp <= 1000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 4. Collection Match Blocks
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin() || isSignedIn());
      allow list: if isSignedIn();

      allow create: if isSignedIn()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          incoming().role == 'student'
          || (isAdmin() && incoming().role == 'owner')
          || ((isComputingTeacher() || isMathTeacher() || isScienceTeacher() || isEnglishTeacher() || isHistoryTeacher() || isUzbekTeacher()) && incoming().role == 'teacher')
        );

      allow update: if isSignedIn()
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isOwner(userId)
            && incoming().role == 'student'
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role', 'email', 'updatedAt']))
          || (isOwner(userId)
            && incoming().role == existing().role
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'updatedAt']))
          || (isOwner(userId)
            && (isComputingTeacher() || isMathTeacher() || isScienceTeacher() || isEnglishTeacher() || isHistoryTeacher() || isUzbekTeacher())
            && incoming().role == 'teacher'
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role', 'email', 'updatedAt']))
          || (isAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'username', 'role', 'email', 'updatedAt']))
        );

      allow delete: if isAdmin() && isValidId(userId);
    }

    match /userCosmetics/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn();

      allow create: if isSignedIn()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserCosmetics(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(userId)
        && isValidUserCosmetics(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isOwner(userId)
            && incoming().spentXp >= existing().spentXp
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'ownedTitles', 'ownedFrames', 'equippedTitle', 'equippedFrame', 'spentXp', 'updatedAt'
            ]))
          || (isAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'ownedTitles', 'ownedFrames', 'equippedTitle', 'equippedFrame', 'spentXp', 'updatedAt'
            ]))
        );

      allow delete: if isAdmin() && isValidId(userId);
    }

    match /attempts/{attemptId} {
      allow get: if isValidId(attemptId) && (
        isAdmin()
        || (isComputingTeacher() && existing().subjectId == 'computing')
        || (isMathTeacher() && existing().subjectId == 'math')
        || (isScienceTeacher() && existing().subjectId == 'science')
        || (isEnglishTeacher() && existing().subjectId == 'english')
        || (isHistoryTeacher() && existing().subjectId == 'history')
        || (isUzbekTeacher() && existing().subjectId == 'uzbek')
        || (isSignedIn() && existing().userId == request.auth.uid)
      );
      allow list: if isAdmin()
        || (isComputingTeacher() && resource.data.subjectId == 'computing')
        || (isMathTeacher() && resource.data.subjectId == 'math')
        || (isScienceTeacher() && resource.data.subjectId == 'science')
        || (isEnglishTeacher() && resource.data.subjectId == 'english')
        || (isHistoryTeacher() && resource.data.subjectId == 'history')
        || (isUzbekTeacher() && resource.data.subjectId == 'uzbek')
        || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isSignedIn()
        && isValidId(attemptId)
        && isValidQuizAttempt(incoming(), attemptId)
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));

      allow update: if false;
      allow delete: if isAdmin() && isValidId(attemptId);
    }

    match /subjectPermissions/{subjectId} {
      allow get: if isSignedIn() && isValidSubjectId(subjectId);
      allow list: if false;

      allow create: if isSignedIn()
        && isValidSubjectId(subjectId)
        && canManageSubjectPermission(subjectId)
        && isValidSubjectPermission(incoming(), subjectId);

      allow update: if isSignedIn()
        && isValidSubjectId(subjectId)
        && canManageSubjectPermission(subjectId)
        && isValidSubjectPermission(incoming(), subjectId)
        && incoming().subjectId == existing().subjectId
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'prohibited', 'updatedByUid', 'updatedByName', 'updatedAt'
        ]);

      allow delete: if isAdmin() && isValidSubjectId(subjectId);
    }

    match /studentAssignments/{assignmentId} {
      allow get: if isSignedIn() && isValidId(assignmentId);
      allow list: if isSignedIn();

      allow create: if isSignedIn()
        && isValidId(assignmentId)
        && canManageSubjectPermission(incoming().subjectId)
        && isValidStudentAssignment(incoming(), assignmentId)
        && incoming().assignedByUid == request.auth.uid;

      allow update: if isSignedIn()
        && isValidId(assignmentId)
        && isValidStudentAssignment(incoming(), assignmentId)
        && incoming().id == existing().id
        && incoming().subjectId == existing().subjectId
        && incoming().studentUid == existing().studentUid
        && incoming().difficulty == existing().difficulty
        && (
          // Action 1: Teacher/Owner updates assignment or resets/grants attempts
          (canManageSubjectPermission(existing().subjectId)
            && incoming().assignedByUid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'variant', 'attemptsAllowed', 'attemptsUsed', 'retakeCodePending',
              'assignedByUid', 'assignedByName', 'updatedAt'
            ]))
          ||
          // Action 2: Assigned student starts test and consumes 1 attempt
          (isAssignedStudent(existing().studentUid)
            && incoming().variant == existing().variant
            && incoming().assignedByUid == existing().assignedByUid
            && incoming().assignedByName == existing().assignedByName
            && 'attemptsUsed' in incoming()
            && 'attemptsAllowed' in incoming()
            && incoming().attemptsUsed >= 1
            && incoming().attemptsUsed <= incoming().attemptsAllowed
            && (
              (!('attemptsUsed' in existing())
                && !('attemptsAllowed' in existing())
                && incoming().attemptsUsed == 1
                && incoming().attemptsAllowed == 1
                && incoming().diff(existing()).affectedKeys().hasOnly(['attemptsUsed', 'attemptsAllowed', 'updatedAt']))
              || ('attemptsUsed' in existing()
                && 'attemptsAllowed' in existing()
                && incoming().attemptsAllowed == existing().attemptsAllowed
                && incoming().attemptsUsed == existing().attemptsUsed + 1
                && incoming().diff(existing()).affectedKeys().hasOnly(['attemptsUsed', 'updatedAt']))
            ))
          ||
          // Action 3: Assigned student marks retakeCodePending atomically while creating retakeCodes doc
          (isAssignedStudent(existing().studentUid)
            && incoming().variant == existing().variant
            && incoming().assignedByUid == existing().assignedByUid
            && incoming().assignedByName == existing().assignedByName
            && incoming().retakeCodePending == true
            && getAfter(/databases/$(database)/documents/retakeCodes/$(assignmentId)).data.status == 'pending'
            && (
              incoming().diff(existing()).affectedKeys().hasOnly(['retakeCodePending', 'updatedAt'])
              || (!('attemptsUsed' in existing())
                && !('attemptsAllowed' in existing())
                && incoming().attemptsUsed == 1
                && incoming().attemptsAllowed == 1
                && incoming().diff(existing()).affectedKeys().hasOnly([
                  'attemptsUsed', 'attemptsAllowed', 'retakeCodePending', 'updatedAt'
                ]))
            ))
          ||
          // Action 4: Assigned student redeems matching teacher code atomically for 2nd attempt
          (isAssignedStudent(existing().studentUid)
            && incoming().variant == existing().variant
            && incoming().assignedByUid == existing().assignedByUid
            && incoming().assignedByName == existing().assignedByName
            && incoming().retakeCodePending == false
            && 'attemptsAllowed' in incoming()
            && incoming().attemptsAllowed <= 5
            && (
              ('attemptsAllowed' in existing() && incoming().attemptsAllowed == existing().attemptsAllowed + 1)
              || (!('attemptsAllowed' in existing()) && incoming().attemptsAllowed == 2)
            )
            && get(/databases/$(database)/documents/retakeCodes/$(assignmentId)).data.status == 'pending'
            && getAfter(/databases/$(database)/documents/retakeCodes/$(assignmentId)).data.status == 'used'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'attemptsAllowed', 'retakeCodePending', 'updatedAt'
            ]))
        );

      allow delete: if isSignedIn() && (
        isAdmin()
        || (isComputingTeacher() && resource.data.subjectId == 'computing')
        || (isMathTeacher() && resource.data.subjectId == 'math')
        || (isScienceTeacher() && resource.data.subjectId == 'science')
        || (isEnglishTeacher() && resource.data.subjectId == 'english')
        || (isHistoryTeacher() && resource.data.subjectId == 'history')
        || (isUzbekTeacher() && resource.data.subjectId == 'uzbek')
      );
    }

    match /retakeCodes/{codeId} {
      // Strictly teachers/owner only — students can NEVER read or list the secret code
      allow get: if isValidId(codeId) && (
        isAdmin()
        || (isComputingTeacher() && existing().subjectId == 'computing')
        || (isMathTeacher() && existing().subjectId == 'math')
        || (isScienceTeacher() && existing().subjectId == 'science')
        || (isEnglishTeacher() && existing().subjectId == 'english')
        || (isHistoryTeacher() && existing().subjectId == 'history')
        || (isUzbekTeacher() && existing().subjectId == 'uzbek')
      );
      allow list: if isAdmin()
        || (isComputingTeacher() && resource.data.subjectId == 'computing')
        || (isMathTeacher() && resource.data.subjectId == 'math')
        || (isScienceTeacher() && resource.data.subjectId == 'science')
        || (isEnglishTeacher() && resource.data.subjectId == 'english')
        || (isHistoryTeacher() && resource.data.subjectId == 'history')
        || (isUzbekTeacher() && resource.data.subjectId == 'uzbek');

      allow create: if isSignedIn()
        && isValidId(codeId)
        && isValidRetakeCode(incoming(), codeId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().status == 'pending'
        && exists(/databases/$(database)/documents/studentAssignments/$(codeId))
        && (
          canManageSubjectPermission(incoming().subjectId)
          || (isAssignedStudent(incoming().studentUid)
            && get(/databases/$(database)/documents/studentAssignments/$(codeId)).data.studentUid == incoming().studentUid
            && get(/databases/$(database)/documents/studentAssignments/$(codeId)).data.subjectId == incoming().subjectId
            && get(/databases/$(database)/documents/studentAssignments/$(codeId)).data.difficulty == incoming().difficulty
            && get(/databases/$(database)/documents/studentAssignments/$(codeId)).data.variant == incoming().variant)
        );

      allow update: if isSignedIn()
        && isValidId(codeId)
        && isValidRetakeCode(incoming(), codeId)
        && incoming().id == existing().id
        && incoming().assignmentId == existing().assignmentId
        && incoming().studentUid == existing().studentUid
        && incoming().subjectId == existing().subjectId
        && incoming().difficulty == existing().difficulty
        && incoming().variant == existing().variant
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Teacher issues/rotates a fresh pending code
          (canManageSubjectPermission(existing().subjectId)
            && incoming().status == 'pending'
            && incoming().diff(existing()).affectedKeys().hasOnly(['code', 'status', 'updatedAt']))
          ||
          // Action 2: Student enters exact matching 6-digit code to redeem 2nd attempt
          (isAssignedStudent(existing().studentUid)
            && existing().status == 'pending'
            && incoming().status == 'used'
            && incoming().code == existing().code
            && incoming().diff(existing()).affectedKeys().hasOnly(['code', 'status', 'updatedAt']))
        );

      allow delete: if isSignedIn() && isValidId(codeId) && canManageSubjectPermission(existing().subjectId);
    }
  }
}
