{
  "id": "chsb-prep",
  "name": "Prep App For 7 Graders",
  "short_name": "CHSB Prep",
  "description": "7-sinf Matematika, Tarix, Science, Informatika, Ingliz tili va Ona tili va Adabiyot fanlaridan 25 talik ChSB testlari va 5 ta variant.",
  "lang": "uz",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "tabbed",
    "fullscreen"
  ],
  "orientation": "any",
  "dir": "ltr",
  "theme_color": "#056608",
  "background_color": "#ffffff",
  "categories": [
    "education",
    "books",
    "utilities"
  ],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "iarc_rating_id": "urn:iarc:rated:3+",
  "icons": [
    {
      "src": "/pwa-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Matematika ChSB",
      "short_name": "Math",
      "description": "7-sinf Matematika fanidan 25 talik testlar",
      "url": "/?subject=math",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Natijalar",
      "short_name": "Natija",
      "description": "O'quvchilar va shaxsiy test natijalari",
      "url": "/?view=results",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/wide.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Wide view of Grade 7 ChSB Prep Platform"
    },
    {
      "src": "/screenshots/narrow.png",
      "sizes": "720x1280",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Narrow view of Grade 7 ChSB Prep Platform"
    }
  ],
  "scope_extensions": [
    {
      "origin": "https://chsb-prep-app.thehonoredone-717.workers.dev"
    },
    {
      "origin": "https://*.thehonoredone-717.workers.dev"
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "edge_side_panel": {
    "preferred_width": 400
  },
  "note_taking": {
    "new_note_url": "/?view=quiz"
  },
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://chsb-prep-app.thehonoredone-717.workers.dev/manifest.json",
      "id": "chsb-prep"
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+chsb",
      "url": "/?protocol=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "application/json": [".json"]
      },
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "widgets": [
    {
      "name": "ChSB Quick Prep Widget",
      "description": "Quick access widget for Grade 7 ChSB practice exams",
      "tag": "chsb-widget",
      "template": "chsb-widget-template",
      "data": "/manifest.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/screenshots/wide.png",
          "sizes": "1280x720",
          "label": "Widget preview"
        }
      ],
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}
